# Runs MC EasyHost without a desktop, e.g. on a home server.
# Install as a user service:
#   cp mc-easyhost.service ~/.config/systemd/user/
#   systemctl --user enable --now mc-easyhost
#   loginctl enable-linger "$USER"   # keep it running after you log out
# Control panel: ssh -L 47615:127.0.0.1:47615 <server>, then http://127.0.0.1:47615
[Unit]
Description=MC EasyHost Minecraft server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/mc-easyhost --headless
# The app asks Minecraft to save and stop on SIGTERM; give it time.
TimeoutStopSec=120
Restart=on-failure

[Install]
WantedBy=default.target
